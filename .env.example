# ── Database ───────────────────────────────────────────────────
# Neon Postgres connection string (pooled).
DATABASE_URL=postgres://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# ── Auth (Auth.js / NextAuth v5) ───────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-a-long-random-string

# The canonical production origin used as the Auth.js trust host fallback.
AUTH_URL=http://localhost:3000

# ── Site domains ───────────────────────────────────────────────
# Used to override the production site hosts for local testing.
NEXT_PUBLIC_BTS_HOST=localhost:3000
NEXT_PUBLIC_MD_HOST=localhost:3000

# ── File storage (prototype: local; production: Vercel Blob) ──
BLOB_READ_WRITE_TOKEN=

# ── Email (Resend) ─────────────────────────────────────────────
# Get your API key at https://resend.com — omit in dev to log emails to console.
RESEND_API_KEY=
FROM_EMAIL=Back to School with Megan <noreply@withmegan.com>